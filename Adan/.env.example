# Rename this file to ".env" and fill in your real key. Never commit the real .env file.

# Mistral API key (free tier) - used by the medical consultant role in app.py
# Get one at https://console.mistral.ai/ -> API Keys -> Create new key
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: override if the backend runs on a different host/port (used by frontend.py)
API_URL=http://localhost:8000

# No key needed for the doctor-finder role - it uses free OpenStreetMap data.
